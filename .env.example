# Copy this file to .env.local and fill in values.
# Never commit .env.local.
#
# Vercel environments:
#   Staging (production branch): https://batchboard-urbandhu.vercel.app
#   Preview (per-PR):            https://batchboard-<hash>-urbandhu.vercel.app
#
# Set the variables below in Vercel → Project → Settings → Environment Variables
# for each environment (Production, Preview, Development).

# ── App ──────────────────────────────────────────────────────────────────────
# Local dev:  http://localhost:3000
# Staging:    https://batchboard-urbandhu.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Anthropic (Claude Batch API) ─────────────────────────────────────────────
# Required for the Claude Batch API integration.
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Supabase (database + auth — add when Supabase is wired up) ───────────────
# Project URL and anon key from Supabase → Project → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Auth (add when auth is wired up) ─────────────────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
